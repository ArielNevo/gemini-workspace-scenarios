# Base path for GitHub Pages project sites, e.g. /my-repo/. Use / for a custom domain root.
VITE_BASE_PATH=/

# Smart guidance module (section 11 of docs/BUILD_BRIEF.md). Off by default.
VITE_ENABLE_AI_ASSIST=false
# Model name must come from config. Verify a stable (non-preview) free-tier model in the official docs.
VITE_GEMINI_MODEL=
# Firebase web app config (not secret, but never commit real values). In Actions: repository variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Extra CSP origins, space separated, only when the AI module is on (see docs/DECISIONS.md).
VITE_CSP_EXTRA_CONNECT=
VITE_CSP_EXTRA_SCRIPT=
VITE_CSP_EXTRA_FRAME=
